# Copy this to .env and adjust values as needed.
# .env is intentionally gitignored - never commit real values.

# Which environment implementation to use: local | azure
ENVIRONMENT=local

# --- local environment ---
TRUST_DOMAIN=experiment.local

# --- azure environment ---
AZURE_TENANT_ID=your-tenant-id-here
AZURE_RESOURCE=https://management.azure.com/.default
